<Window x:Class="CustomizedBrowser.Views.MergeInstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="合并实例"
        Height="640"
        Width="840"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明 -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="勾选要参与合并的实例（建议 2 个及以上），点击「分析」后为冲突网站选择要保留的数据来源。"/>

        <!-- 来源实例列表 -->
        <ListView x:Name="SourcesListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 目标实例与分析按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="合并到：" VerticalAlignment="Center"/>
            <ComboBox x:Name="TargetComboBox" Width="300" VerticalAlignment="Center"
                      SelectionChanged="TargetComboBox_SelectionChanged"/>
            <Button x:Name="AnalyzeButton" Content="分析" Click="AnalyzeButton_Click" Width="90" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 冲突列表标题与统计 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,4">
            <TextBlock Text="冲突网站（同一网站存在于多个实例，请选择保留哪个实例的数据）" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 冲突网站列表 -->
        <ListView x:Name="ConflictsListView" Grid.Row="4">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Host}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DataText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 进度与状态 -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="MergeButton" Content="合并" Click="MergeButton_Click" Width="90" IsDefault="True"
                    IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Width="90"/>
        </StackPanel>
    </Grid>
</Window>