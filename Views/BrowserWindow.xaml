<Window x:Class="CustomizedBrowser.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:CustomizedBrowser.Views"
        mc:Ignorable="d"
        Title="Customized Browser" 
        Height="1080" 
        Width="1920"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <ToolBar Grid.Row="0" Padding="5">
            <Button Name="BackButton" ToolTip="后退 (Alt+←)" Click="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
            </Button>
            <Button Name="ForwardButton" ToolTip="前进 (Alt+→)" Click="ForwardButton_Click">
                <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20"/>
            </Button>
            <Button Name="RefreshButton" ToolTip="刷新 (Ctrl+R)" Click="RefreshButton_Click">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
            </Button>
            <Button Name="HomeButton" ToolTip="实例管理" Click="HomeButton_Click">
                <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20"/>
            </Button>
            <Separator/>
            <TextBox Name="AddressBar" 
                     MinWidth="400" 
                     MaxWidth="800" 
                     VerticalAlignment="Center"
                     KeyDown="AddressBar_KeyDown"
                     materialDesign:HintAssist.Hint="输入网址"/>
            <Button Name="GoButton" ToolTip="转到" Click="GoButton_Click">
                <materialDesign:PackIcon Kind="ArrowRightBold" Width="20" Height="20"/>
            </Button>
            <Separator/>
            <Button Name="NewTabButton" ToolTip="新建标签页 (Ctrl+T)" Click="NewTabButton_Click">
                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
            </Button>
            <Button Name="CloseTabButton" ToolTip="关闭标签页 (Ctrl+W)" Click="CloseTabButton_Click">
                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
            </Button>
            <Separator/>
            <Button Name="DevToolsButton" ToolTip="开发者工具 (F12)" Click="DevToolsButton_Click">
                <materialDesign:PackIcon Kind="CodeTags" Width="20" Height="20"/>
            </Button>
            <Button Name="SettingsButton" ToolTip="设置" Click="SettingsButton_Click">
                <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
            </Button>
        </ToolBar>

        <!-- 加载进度条 -->
        <ProgressBar Name="LoadingProgressBar" 
                     Grid.Row="1" 
                     Height="3"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Visibility="Collapsed"
                     Style="{DynamicResource MaterialDesignLinearProgressBar}"
                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
        
        <!-- 标签页控件 -->
        <local:ScrollableTabControl x:Name="TabControl" Grid.Row="2"/>

    </Grid>
</Window>
