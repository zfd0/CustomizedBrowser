<Window x:Class="CustomizedBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:CustomizedBrowser.Models"
        xmlns:converters="clr-namespace:CustomizedBrowser.Converters"
        mc:Ignorable="d"
        Title="设置"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolInvertConverter x:Key="BoolInvertConverter"/>
        <converters:MultiValueConverter x:Key="MultiValueConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设置内容 -->
        <ScrollViewer x:Name="RootScrollViewer" Grid.Row="0" Padding="16" VerticalScrollBarVisibility="Auto">
            <TabControl PreviewMouseWheel="TabControl_PreviewMouseWheel">
                <!-- 基本设置 -->
                <TabItem Header="基本设置">
                    <StackPanel Margin="8">
                        <!-- 默认页面 -->
                        <StackPanel Margin="0,0,0,12">
                            <Label Content="默认页面 URL" />
                            <TextBox Text="{Binding CurrentSettings.DefaultPageUrl, Mode=TwoWay}" 
                                     materialDesign:HintAssist.Hint="输入默认页面地址"/>
                            
                            <!-- 本地默认页面选项 -->
                            <StackPanel Margin="0,12,0,0">
                                <CheckBox IsChecked="{Binding CurrentSettings.UseLocalDefaultPage, Mode=TwoWay}" 
                                          Content="使用本地默认页面（新标签页样式）"/>
                                
                                <StackPanel Margin="20,8,0,0">
                                    <Label Content="自定义本地页面路径（可选）" 
                                           VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding CurrentSettings.CustomLocalPagePath, Mode=TwoWay}" 
                                                 Width="300"
                                                 materialDesign:HintAssist.Hint="留空使用内置模板，或指定HTML文件路径"/>
                                        <Button Content="浏览..." 
                                                Margin="8,0,0,0"
                                                Click="BrowseLocalPageButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 启动时恢复上次页面 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.RestoreLastPageOnStartup, Mode=TwoWay}" 
                                      Content="启动时恢复上次访问的页面"/>
                        </StackPanel>

                        <!-- 启动时恢复会话 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.RestoreSessionOnStartup, Mode=TwoWay}" 
                                      Content="启动时恢复所有标签页状态"/>
                        </StackPanel>

                        <!-- 界面主题 -->
                        <StackPanel Margin="0,0,0,12">
                            <Label Content="界面主题" />
                            <ComboBox SelectedValue="{Binding CurrentSettings.Theme, Mode=TwoWay}" 
                                      SelectedValuePath="Tag" Width="200">
                                <ComboBoxItem Content="浅色" Tag="{x:Static models:ThemeOption.Light}"/>
                                <ComboBoxItem Content="深色" Tag="{x:Static models:ThemeOption.Dark}"/>
                                <ComboBoxItem Content="跟随系统" Tag="{x:Static models:ThemeOption.System}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 默认窗口分辨率 -->
                        <StackPanel Margin="0,0,0,12">
                            <Label Content="默认窗口分辨率" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="180" Name="ResolutionPresetComboBox" 
                                          SelectionChanged="ResolutionPresetComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自定义" Tag="Custom"/>
                                    <ComboBoxItem Content="800 × 600 (VGA)" Tag="800,600"/>
                                    <ComboBoxItem Content="1024 × 768 (XGA)" Tag="1024,768"/>
                                    <ComboBoxItem Content="1280 × 720 (720p)" Tag="1280,720"/>
                                    <ComboBoxItem Content="1280 × 1024 (SXGA)" Tag="1280,1024"/>
                                    <ComboBoxItem Content="1366 × 768 (笔记本)" Tag="1366,768"/>
                                    <ComboBoxItem Content="1440 × 900 (宽屏)" Tag="1440,900"/>
                                    <ComboBoxItem Content="1680 × 1050 (宽屏)" Tag="1680,1050"/>
                                    <ComboBoxItem Content="1920 × 1080 (1080p)" Tag="1920,1080"/>
                                    <ComboBoxItem Content="2560 × 1440 (2K)" Tag="2560,1440"/>
                                    <ComboBoxItem Content="3840 × 2160 (4K)" Tag="3840,2160"/>
                                </ComboBox>
                                <TextBox Text="{Binding CurrentSettings.DefaultWindowWidth, Mode=TwoWay}" 
                                         Width="80" materialDesign:HintAssist.Hint="宽度" Margin="8,0,0,0"/>
                                <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBox Text="{Binding CurrentSettings.DefaultWindowHeight, Mode=TwoWay}" 
                                         Width="80" materialDesign:HintAssist.Hint="高度"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 系统托盘文本 -->
                        <StackPanel>
                            <Label Content="系统托盘显示文本" />
                            <TextBox Text="{Binding CurrentSettings.TrayIconText, Mode=TwoWay}" 
                                     materialDesign:HintAssist.Hint="托盘图标显示的文本"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 通知设置 -->
                <TabItem Header="通知设置">
                    <StackPanel Margin="8">
                        <!-- 启用通知 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.Notifications.EnableNotifications, Mode=TwoWay}" 
                                      Content="启用通知"/>
                        </StackPanel>

                        <StackPanel Margin="20,0,0,0">
                            <!-- 下载通知 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding CurrentSettings.Notifications.ShowDownloadNotifications, Mode=TwoWay}" 
                                          Content="显示下载通知"/>
                            </StackPanel>

                            <!-- 更新通知 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding CurrentSettings.Notifications.ShowUpdateNotifications, Mode=TwoWay}" 
                                          Content="显示更新通知"/>
                            </StackPanel>

                            <!-- 声音 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding CurrentSettings.Notifications.SoundEnabled, Mode=TwoWay}" 
                                          Content="通知时播放声音"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 数据同步 -->
                <TabItem Header="数据同步">
                    <StackPanel Margin="8">
                        <!-- 启用同步 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.Sync.EnableSync, Mode=TwoWay}" 
                                      Content="启用数据同步"/>
                        </StackPanel>

                        <StackPanel Margin="20,0,0,0">
                            <!-- 同步书签 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding CurrentSettings.Sync.SyncBookmarks, Mode=TwoWay}" 
                                          Content="同步书签"/>
                            </StackPanel>

                            <!-- 同步历史记录 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding CurrentSettings.Sync.SyncHistory, Mode=TwoWay}" 
                                          Content="同步历史记录"/>
                            </StackPanel>

                            <!-- 同步浏览器设置 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding CurrentSettings.Sync.SyncBrowserSettings, Mode=TwoWay}" 
                                          Content="同步浏览器设置"/>
                            </StackPanel>

                            <!-- 同步服务器地址 -->
                            <StackPanel>
                                <Label Content="同步服务器地址" />
                                <TextBox Text="{Binding CurrentSettings.Sync.SyncServerUrl, Mode=TwoWay}" 
                                         materialDesign:HintAssist.Hint="输入服务器地址"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 安全设置 -->
                <TabItem Header="安全设置">
                    <StackPanel Margin="8">
                        <!-- 阻止跟踪Cookie -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.Security.BlockTrackingCookies, Mode=TwoWay}" 
                                      Content="阻止跟踪 Cookie"/>
                        </StackPanel>

                        <!-- 启用自动锁定 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.Security.EnableAutoLock, Mode=TwoWay}" 
                                      Content="启用自动锁定"/>
                        </StackPanel>

                        <StackPanel Margin="20,0,0,0">
                            <!-- 自动锁定时间 -->
                            <StackPanel Margin="0,0,0,12">
                                <Label Content="自动锁定时间（分钟）" />
                                <TextBox Text="{Binding CurrentSettings.Security.AutoLockMinutes, Mode=TwoWay}" 
                                         Width="100" materialDesign:HintAssist.Hint="分钟"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 启动时需要密码 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding CurrentSettings.Security.RequirePasswordOnStartup, Mode=TwoWay}" 
                                      Content="启动时需要密码"/>
                        </StackPanel>

                        <!-- 默认启用隐私模式 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding CurrentSettings.Security.EnablePrivateModeByDefault, Mode=TwoWay}" 
                                      Content="默认启用隐私模式"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 缓存管理 -->
                <TabItem Header="缓存管理">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!-- 缓存配置 -->
                            <GroupBox Header="缓存配置" Margin="0,0,0,12">
                                <StackPanel Margin="8">
                                    <!-- 最大缓存大小 -->
                                    <StackPanel Margin="0,0,0,12">
                                        <Label Content="最大缓存大小（MB，0 表示不限制）" />
                                        <TextBox Text="{Binding CurrentSettings.Cache.MaxCacheSizeMB, Mode=TwoWay}" 
                                                 Width="120" materialDesign:HintAssist.Hint="MB"/>
                                    </StackPanel>

                                    <!-- 退出时自动清除缓存 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                        <CheckBox IsChecked="{Binding CurrentSettings.Cache.AutoClearOnExit, Mode=TwoWay}" 
                                                  Content="退出时自动清除缓存"/>
                                    </StackPanel>

                                    <!-- 自动清除缓存间隔 -->
                                    <StackPanel>
                                        <Label Content="自动清除缓存间隔（天，0 表示不自动清除）" />
                                        <TextBox Text="{Binding CurrentSettings.Cache.ClearCacheIntervalDays, Mode=TwoWay}" 
                                                 Width="120" materialDesign:HintAssist.Hint="天数"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- 缓存信息 -->
                            <GroupBox Header="缓存信息">
                                <StackPanel Margin="8">
                                    <!-- 操作按钮 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Command="{Binding RefreshCacheInfoCommand}" 
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="刷新缓存信息"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ClearAllCacheCommand}" 
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Foreground="White" Background="{DynamicResource MaterialDesignDarkBackground}"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="清除所有缓存"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportDomainListCommand}" 
                                                Style="{StaticResource MaterialDesignFlatButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="导出域名列表"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 加载中指示器 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" 
                                                Visibility="{Binding IsCacheLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Loading" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="正在加载缓存信息..." VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 缓存总大小 -->
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="8,4" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="缓存总大小：" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalCacheSizeText}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 实例缓存列表 -->
                                    <ItemsControl ItemsSource="{Binding InstanceCacheInfos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                        BorderThickness="0,0,0,1" 
                                                        Padding="4" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <!-- 实例缓存行 -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.ToggleInstanceCacheDetailCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Width="24" Height="24" Padding="0">
                                                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Setter Property="LayoutTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="0"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="LayoutTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                            </Button>
                                                            <TextBlock Text="{Binding InstanceId}" 
                                                                       VerticalAlignment="Center" 
                                                                       Width="200" 
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding CacheSizeText}" 
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                       Width="100"/>
                                                            <Button Command="{Binding DataContext.ClearInstanceCacheCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Margin="4,0,0,0"
                                                                    IsEnabled="{Binding IsClearingCache, Converter={StaticResource BoolInvertConverter}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="清除缓存"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- 域名缓存详情（展开时显示） -->
                                                        <ItemsControl ItemsSource="{Binding Domains}" 
                                                                      Margin="28,4,0,0"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                                            BorderThickness="0,0,0,0.5" 
                                                                            Padding="4,2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Domain}" 
                                                                                       Width="160" 
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Width="100" VerticalAlignment="Center">
                                                                                <Run Text="访问 "/>
                                                                                <Run Text="{Binding VisitCount}"/>
                                                                                <Run Text=" 次"/>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding LastVisitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                                                                       Width="140" 
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Width="70" VerticalAlignment="Center">
                                                                                <Run Text="Cookie "/>
                                                                                <Run Text="{Binding CookieCount}"/>
                                                                            </TextBlock>
                                                                            <Button Command="{Binding DataContext.ClearDomainCacheCommand, 
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                                    Style="{StaticResource MaterialDesignFlatButton}">
                                                                                <Button.CommandParameter>
                                                                                        <MultiBinding Converter="{StaticResource MultiValueConverter}">
                                                                                            <Binding Path="DataContext.InstanceId" 
                                                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                            <Binding Path="Domain"/>
                                                                                        </MultiBinding>
                                                                                    </Button.CommandParameter>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" Margin="0,0,4,0"/>
                                                                                    <TextBlock Text="清除"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" 
                    Margin="16">
            <Button Command="{Binding ResetSettingsCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,4,0"/>
                    <TextBlock Text="重置"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveSettingsCommand}" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0"/>
                    <TextBlock Text="保存"/>
                </StackPanel>
            </Button>
            <Button Click="CloseButton_Click" 
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,4,0"/>
                    <TextBlock Text="关闭"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>